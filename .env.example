# ============================================================
# Drug Repurposing Chat API — Environment Variables
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
# ============================================================

# ---- Required -----------------------------------------------

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# ---- Gemini Model Configuration (optional) ------------------

# Embedding model used to vectorise document chunks and queries.
# Must match the dimension set in GEMINI_EMBEDDING_DIMENSION.
GEMINI_EMBEDDING_MODEL=your-embedding-model-here

# Expected output dimension of the embedding model above.
# Update this if you switch to a model with a different dimension.
GEMINI_EMBEDDING_DIMENSION=your-embedding-dimension-here

# Generative model used to produce chat responses.
GEMINI_CHAT_MODEL=your-chat-model-here

# ---- Storage Paths (optional, defaults shown) ---------------

# Directory where ChromaDB persists its vector index on disk.
CHROMA_DB_DIR=./data/chroma

# Name of the ChromaDB collection that holds document chunks.
CHROMA_COLLECTION_NAME=drug_docs

# Root directory containing per-drug PDF subfolders.
# Each subfolder should be named after the drug (e.g. "aspirin repurposing").
DOCS_DIR=./data/docs

# ---- Caching (optional, defaults shown) ---------------------

# Seconds before the in-memory drug list is refreshed from ChromaDB.
# Set to 0 to disable TTL-based expiry (cache never auto-expires).
DRUGS_CACHE_TTL_SECONDS=300

# Maximum number of unique drugs to load during startup scan.
# Set to 0 for unlimited — useful for very large collections.
MAX_DRUGS_TO_LOAD=0

# ---- S3 Integration (optional) ------------------------------

# S3 bucket name for PDF storage and ingestion.
# Leave unset to disable S3 support entirely.
# S3_BUCKET=your-bucket-name-here

# Key prefix inside the S3 bucket (no leading/trailing slash).
# S3_PREFIX=your-prefix-here

# AWS region for the S3 bucket.
# S3_REGION=your-region-here
